<p style="color: green"><%= notice %></p>

<% content_for :title, "Posts" %>

<h1>Posts</h1>

<div id="posts">
  <% @posts.each do |post| %>
    <%= render post %>
    <p>
      <%= link_to "Show this post", post %>
    </p>
  <% end %>
</div>

<br>
<br>

<p> <%= show_visit_count(@visit_count) %> </p>

<br>
<br>

<% if session[:last_viewed_post_id] %>
  <p>Last post you viewed: <%= link_to "Post ##{session[:last_viewed_post_id]}", post_path(session[:last_viewed_post_id]) %> </p>
<% end %>

<%= link_to "New post", new_post_path %>
